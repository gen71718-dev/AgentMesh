# ---------------------------------------------------------------------------
# AgentMesh configuration. Every variable is optional - copy to `.env` and
# uncomment what you need. The prefix is always AGENTMESH_.
# ---------------------------------------------------------------------------

# ---- App ----
AGENTMESH_ENVIRONMENT=local
AGENTMESH_DEBUG=false
AGENTMESH_LOG_LEVEL=INFO
AGENTMESH_LOG_JSON=true
AGENTMESH_HOST=0.0.0.0
AGENTMESH_PORT=8100
AGENTMESH_API_PREFIX=/api/v1
AGENTMESH_CORS_ORIGINS=*

# ---- LLM provider: mock | openai | anthropic | ollama ----
# `mock` is a deterministic offline model - great for tests and for a first run.
AGENTMESH_LLM_PROVIDER=mock
AGENTMESH_LLM_MODEL=gpt-4o-mini
AGENTMESH_LLM_TEMPERATURE=0.0
AGENTMESH_LLM_TIMEOUT_SECONDS=60
# AGENTMESH_OPENAI_API_KEY=sk-...
# AGENTMESH_OPENAI_BASE_URL=https://api.openai.com/v1
# AGENTMESH_ANTHROPIC_API_KEY=sk-ant-...
# AGENTMESH_OLLAMA_BASE_URL=http://localhost:11434

# ---- Redis ----
AGENTMESH_REDIS_URL=redis://localhost:6379/0
AGENTMESH_REDIS_NAMESPACE=agentmesh
AGENTMESH_REDIS_TTL_SECONDS=86400
AGENTMESH_REDIS_STREAM_MAXLEN=5000

# ---- Storage ----
# memory  -> single process, zero dependencies (default)
# redis   -> shared state, horizontal scaling, durable event log
AGENTMESH_STATE_BACKEND=memory
# memory | redis
#   redis needs `pip install "agentmesh[redis-checkpoint]"` *and* a Redis Stack
#   server (redis/redis-stack-server): the checkpointer indexes with RediSearch,
#   which a plain redis-server does not ship. An unusable server falls back to
#   memory with a warning instead of failing startup.
AGENTMESH_CHECKPOINT_BACKEND=memory

# ---- Execution ----
# inline -> the API process runs the graph in the background
# queue  -> the API enqueues, `agentmesh worker` processes run the graph
AGENTMESH_EXECUTION_MODE=inline
AGENTMESH_WORKER_CONCURRENCY=4
AGENTMESH_RUN_TIMEOUT_SECONDS=300

# ---- Orchestration ----
AGENTMESH_MAX_SUPERVISOR_STEPS=8
AGENTMESH_MAX_TOOL_ITERATIONS=3
AGENTMESH_ENABLE_PYTHON_TOOL=false
# AGENTMESH_KNOWLEDGE_DIR=./docs/knowledge

# ---- Optional tool backends ----
# AGENTMESH_TAVILY_API_KEY=tvly-...
